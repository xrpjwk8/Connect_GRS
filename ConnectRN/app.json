{
  "expo": {
    "name": "ConnectRN",
    "slug": "ConnectRN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Connect_logo2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "3",
      "bundleIdentifier": "com.xrpjwk8.ConnectRN",
      "appleTeamId": "7C2363N8Z6",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6FF3D",
        "foregroundImage": "./assets/Connect_logo2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xrpjwk8.connectrn",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-notifications",
      "./plugins/withVendorSymbols"
    ],
    "extra": {
      "eas": {
        "projectId": "2fa26408-1e64-49bd-a852-bccceca4c268"
      }
    },
    "owner": "xrpjwk8"
  }
}
